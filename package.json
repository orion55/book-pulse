{
  "name": "book-pulse",
  "description": "Программа для отслеживание новых книг",
  "version": "1.2.0",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/orion55/book-pulse.git"
  },
  "keywords": [
    "синхронизация",
    "книги"
  ],
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "scripts": {
    "migrate": "prisma migrate deploy",
    "predev": "npm run migrate",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/processHelpers.test.ts tests/fetchHtmlWithRetry.test.ts tests/parseBooks.test.ts tests/dataSync.test.ts tests/sendMessage.test.ts tests/dockerProduction.test.ts",
    "generate-clients": "npx prisma generate",
    "lint": "npx eslint .",
    "format": "npx prettier --write .",
    "docker": "docker compose down --remove-orphans && docker compose up --build --force-recreate"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/ansi-colors": "^3.2.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@vercel/ncc": "^0.45.0",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "ansi-colors": "^4.1.3",
    "cfonts": "^3.3.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "lodash": "^4.18.1",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
